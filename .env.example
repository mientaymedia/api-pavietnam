# ============================================================
#  CAU HINH UNG DUNG  (copy file nay thanh .env roi dien gia tri)
#  KHONG BAO GIO commit file .env len git
# ============================================================

NODE_ENV=production
PORT=3000
# URL cong khai cua site (dung cho link thanh toan, callback, email)
APP_URL=https://mientaymedia.com
# Tien to duong dan khi app chay duoi thu muc con, vd /ten-mien (chu thuong,
# bat dau bang /). De trong = chay o goc. PHAI khop phan duong dan cua APP_URL,
# vd APP_URL=https://mientaymedia.com/ten-mien thi BASE_PATH=/ten-mien; lech
# nhau thi app dung ngay khi khoi dong. Proxy chuyen /ten-mien/* sang app,
# KHONG cat tien to.
BASE_PATH=
# Cong "Tai khoan MienTay" cung app, cung phien, vd /tai-khoan (docs/mtm/
# tai-khoan-chung/spec.md). Chi bat duoc khi BASE_PATH khac rong; khong trung,
# khong long voi BASE_PATH. Proxy chuyen /tai-khoan/* sang app, KHONG cat tien
# to. De trong = tat (duong lui: trang dang nhap cu o /ten-mien hien lai).
CONG_TAI_KHOAN_PATH=
APP_NAME=MienTay Media

# Chuoi bi mat de ky cookie phien + ma hoa secret trong DB.
# Sinh bang:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=thay_bang_chuoi_ngau_nhien_64_ky_tu
ENCRYPTION_KEY=thay_bang_chuoi_ngau_nhien_64_ky_tu

# Duong dan file SQLite
DATABASE_FILE=./data/app.sqlite

# Dat 1 khi chay sau reverse proxy (nginx / cloudflare) de lay dung IP that
TRUST_PROXY=1

# Dat 1 khi ban chay worker rieng (node dist/jobs/worker.js) de hai tien trinh
# khong tranh cung mot job. De trong = worker chay chung tien trinh web.
WORKER_DISABLED=0

# ------------------------------------------------------------
#  API DAI LY P.A VIET NAM
#  Luu y: API chi cho phep goi tu IP da dang ky whitelist voi P.A.
#  API Key se DOI khi ban doi mat khau tai khoan dai ly.
# ------------------------------------------------------------
PAVIETNAM_ENDPOINT=https://daily.pavietnam.vn/interface.php
PAVIETNAM_USERNAME=
PAVIETNAM_APIKEY=
# Timeout goi API (ms) va so lan thu lai khi loi mang
PAVIETNAM_TIMEOUT_MS=30000
PAVIETNAM_RETRIES=2
# Bat che do gia lap: khong goi API that, tra du lieu mau (dung khi dev / IP chua whitelist)
PAVIETNAM_SANDBOX=0
# Ghi log toan bo request/response API vao bang api_logs (tat tren production neu lo ngai dung luong)
PAVIETNAM_LOG=1

# Che do thu: lenh ghi (dang ky, gia han, doi DNS) di interface_test.php, P.A tra 900
# va khong tru tien. Lenh doc (check_whois, so du, ngay het han) van di endpoint that.
PAVIETNAM_ENDPOINT_TEST=https://daily.pavietnam.vn/interface_test.php
PA_USE_TEST_ENDPOINT=0

# Ten lenh mac dinh theo tai lieu API_PAVIETNAM.pdf; chi ghi de khi P.A doi ten
# PA_ACTION_REGISTER_VN=register_domain_vietnam
# PA_ACTION_REGISTER_INTL=register_domain_quocte
# PA_ACTION_RENEW=renew_domain
# PA_ACTION_DNS_VN=change_dns_domain_vietnam
# PA_ACTION_DNS_INTL=change_dns_domain_quocte
# PA_ACTION_DATES=get_date_domain
# PA_ACTION_BALANCE=check_account_still
# PA_ACTION_OWNED=check_domain

# ------------------------------------------------------------
#  TELEGRAM QUAN TRI (@mientaymediabot)
#  Bao don moi, dang ky xong, thieu quy (nut "Da nap, kich hoat"), loi can nguoi xu ly;
#  nhan lenh /kichhoat /sodu /doncho qua webhook POST <APP_URL>/webhooks/telegram.
#  Cau hinh trong Quan tri chi ghi de khi nhap. Khong commit gia tri that.
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Chat id duoc phep (nhan tin va ra lenh), cach nhau dau phay
TELEGRAM_ADMIN_CHAT_IDS=
# Chuoi ngau nhien, trung secret_token khi goi setWebhook
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------
#  CRM (crm.mientaymedia.com)
#  WEB_TEN_MIEN_KEY: khoa CRM dung goi cong /api/noi-bo/* cua web (nhieu khoa cach dau phay, moi khoa >= 32 ky tu)
#  CRM_URL, CRM_INTEGRATION_KEY: web day su kien sang CRM (khoa nam trong INTEGRATION_WEB_KEYS ben CRM);
#  bat bang o "Day su kien don hang sang CRM" trong Quan tri > Cau hinh
# ------------------------------------------------------------
WEB_TEN_MIEN_KEY=
CRM_URL=
CRM_INTEGRATION_KEY=

# ------------------------------------------------------------
#  DANG NHAP BANG ZALO, GOOGLE, GITHUB
#  Ben nao de trong id hoac secret thi nut cua ben do khong hien (mac dinh tat).
#  Quan tri > Cau hinh ghi de khi nhap (secret luu ma hoa).
#  Redirect URI khai bao o trang developer cua tung ben:
#     <APP_URL>/auth/zalo/callback
#     <APP_URL>/auth/google/callback
#     <APP_URL>/auth/github/callback
# ------------------------------------------------------------
ZALO_APP_ID=
ZALO_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Chi cho test: tro ba ben ve may chu gia lap cuc bo. Bi bo qua khi NODE_ENV=production.
# OAUTH_MOCK_BASE=http://127.0.0.1:4010

# ------------------------------------------------------------
#  TIM CUNG AI (OpenAI)
#  Khoa OpenAI, model, tran chi phi, gioi han: nhap trong Quan tri > Cau hinh,
#  KHONG dat o day. Chi doi dia chi API khi dung cong tuong thich OpenAI.
# ------------------------------------------------------------
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------
#  EMAIL - gui thong tin quan tri domain cho khach
# ------------------------------------------------------------
# Cach chinh (chu chot 21/10/2026): Resend HTTP API.
#   MAIL_DRIVER=resend   RESEND_API_KEY=re_... (resend.com > API Keys, quyen Sending)
#   Khoa cung nhap duoc o Quan tri > Cau hinh (luu ma hoa); khong bao gio ghi vao log.
#   MAIL_FROM phai thuoc ten mien da xac minh tren Resend: updates.mientaymedia.com
#   hoac api.mientaymedia.com. mientaymedia.com goc CHUA xac minh.
MAIL_DRIVER=smtp
RESEND_API_KEY=
MAIL_REPLY_TO=hello@mientaymedia.com
#
# Cach phu: SMTP cua Resend (de MAIL_DRIVER=smtp):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465 SMTP_SECURE=1  (hoac SMTP_PORT=587 SMTP_SECURE=0, STARTTLS)
#   SMTP_USER=resend           SMTP_PASS=<RESEND_API_KEY>
#
# Vi du Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   SMTP_SECURE=1
#   SMTP_USER phai la DIA CHI EMAIL DAY DU (hello@congty.com), khong phai ten tai khoan
#   SMTP_PASS la "mat khau ung dung" 16 ky tu, khong phai mat khau dang nhap
#   MAIL_FROM phai la dia chi da khai trong Gmail (Settings > Accounts > Send mail as),
#   neu khong Gmail se tu doi nguoi gui va email de vao spam
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MienTay Media <no-reply@updates.mientaymedia.com>"
# Email nhan canh bao noi bo (don hang moi, provision that bai)
ADMIN_ALERT_EMAIL=

# ------------------------------------------------------------
#  THANH TOAN - SEPAY (chuyen khoan ngan hang + doi soat tu dong)
#  Dang ky tai https://my.sepay.vn - lien ket tai khoan ngan hang cua
#  doanh nghiep, khong can cong thanh toan trung gian.
#
#  Sau khi deploy, vao my.sepay.vn > Cong ty > Webhooks va tao webhook:
#     URL   : https://<ten-mien-cua-ban>/webhooks/sepay
#     Kieu  : Tat ca giao dich (hoac chi tien vao)
#     Header: Authorization: Apikey <SEPAY_WEBHOOK_TOKEN ben duoi>
# ------------------------------------------------------------
SEPAY_ENABLED=1
# Ma ngan hang viet tat dung cho QR: ACB, VCB, TCB, MB, BIDV, VPB, TPB...
SEPAY_BANK_CODE=MB
SEPAY_BANK_NAME=MB
SEPAY_ACCOUNT_NUMBER=45688840
# Dien DUNG ten chu tai khoan nhu dang ky voi ngan hang
SEPAY_ACCOUNT_NAME=CONG TY TNHH PHAN MEM MIENTAY MEDIA
# Chuoi bi mat BAN tu dat, phai trung voi header Apikey khai bao tren SePay
SEPAY_WEBHOOK_TOKEN=
# API Token (my.sepay.vn > API Token) - dung de doi soat bu khi webhook that lac
SEPAY_API_TOKEN=

# ------------------------------------------------------------
#  THANH TOAN - MOMO (AIO v2)
# ------------------------------------------------------------
MOMO_ENABLED=0
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ------------------------------------------------------------
#  THANH TOAN - ZALOPAY (v2)
# ------------------------------------------------------------
ZALOPAY_ENABLED=0
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

# ------------------------------------------------------------
#  ZALO ZNS (thong bao qua Zalo Official Account)
#  Cau hinh day du hon o giao dien: Quan tri > Cau hinh Control Panel > Zalo ZNS
#
#  Chuan bi tai https://developers.zalo.me :
#    1. Tao ung dung, lien ket voi Zalo OA cua doanh nghiep
#    2. Lay App ID + Secret Key
#    3. Cap refresh_token lan dau qua luong OAuth cua Zalo
#    4. Tao va cho duyet mau tin tai https://business.zalo.me
#
#  LUU Y: Zalo doi refresh_token MOI LAN dung. He thong tu luu lai ban moi vao
#  CSDL - nen sau lan chay dau, gia tri trong .env se khong con dung nua (dieu
#  nay binh thuong). Dat token o giao dien admin thi tien theo doi hon.
# ------------------------------------------------------------
ZNS_ENABLED=0
ZNS_APP_ID=
ZNS_SECRET_KEY=
ZNS_REFRESH_TOKEN=

# ------------------------------------------------------------
#  XAC THUC EMAIL
# ------------------------------------------------------------
# Dat 1 de BAT BUOC khach xac thuc email truoc khi dat hang
AUTH_REQUIRE_EMAIL_VERIFIED=0

# ------------------------------------------------------------
#  TAI KHOAN QUAN TRI KHOI TAO (chi dung luc chay `npm run seed`)
# ------------------------------------------------------------
ADMIN_EMAIL=EM@mientaymedia.com
ADMIN_PASSWORD=doi_mat_khau_nay_ngay

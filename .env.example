# ============================================================
#  CAU HINH UNG DUNG  (copy file nay thanh .env roi dien gia tri)
#  KHONG BAO GIO commit file .env len git
# ============================================================

NODE_ENV=production
PORT=3000
# URL cong khai cua site (dung cho link thanh toan, callback, email)
APP_URL=https://mientaymedia.com
APP_NAME=Mien Tay Media

# Chuoi bi mat de ky cookie phien + ma hoa secret trong DB.
# Sinh bang:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=thay_bang_chuoi_ngau_nhien_64_ky_tu
ENCRYPTION_KEY=thay_bang_chuoi_ngau_nhien_64_ky_tu

# Duong dan file SQLite
DATABASE_FILE=./data/app.sqlite

# Dat 1 khi chay sau reverse proxy (nginx / cloudflare) de lay dung IP that
TRUST_PROXY=1

# ------------------------------------------------------------
#  API DAI LY P.A VIET NAM
#  Luu y: API chi cho phep goi tu IP da dang ky whitelist voi P.A.
#  API Key se DOI khi ban doi mat khau tai khoan dai ly.
# ------------------------------------------------------------
PAVIETNAM_ENDPOINT=https://daily.pavietnam.vn/interface.php
PAVIETNAM_USERNAME=
PAVIETNAM_APIKEY=
# Timeout goi API (ms) va so lan thu lai khi loi mang
PAVIETNAM_TIMEOUT_MS=30000
PAVIETNAM_RETRIES=2
# Bat che do gia lap: khong goi API that, tra du lieu mau (dung khi dev / IP chua whitelist)
PAVIETNAM_SANDBOX=0
# Ghi log toan bo request/response API vao bang api_logs (tat tren production neu lo ngai dung luong)
PAVIETNAM_LOG=1

# Ghi de ten action neu tai lieu P.A cua ban dung ten khac (xem docs/API-PAVIETNAM.md)
# PA_ACTION_CHECK=checkdomain
# PA_ACTION_REGISTER=regdomain
# PA_ACTION_RENEW=renewdomain
# PA_ACTION_WHOIS=whois
# PA_ACTION_DNS_GET=getdns
# PA_ACTION_DNS_SET=updatedns
# PA_ACTION_NS_SET=changens
# PA_ACTION_LIST=listdomain
# PA_ACTION_INFO=domaininfo
# PA_ACTION_BALANCE=balance

# ------------------------------------------------------------
#  EMAIL (SMTP) - gui thong tin quan tri domain cho khach
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mien Tay Media <no-reply@mientaymedia.com>"
# Email nhan canh bao noi bo (don hang moi, provision that bai)
ADMIN_ALERT_EMAIL=

# ------------------------------------------------------------
#  THANH TOAN - SEPAY (chuyen khoan ngan hang + doi soat tu dong)
#  Dang ky tai https://my.sepay.vn - lien ket tai khoan ngan hang cua
#  doanh nghiep, khong can cong thanh toan trung gian.
#
#  Sau khi deploy, vao my.sepay.vn > Cong ty > Webhooks va tao webhook:
#     URL   : https://<ten-mien-cua-ban>/webhooks/sepay
#     Kieu  : Tat ca giao dich (hoac chi tien vao)
#     Header: Authorization: Apikey <SEPAY_WEBHOOK_TOKEN ben duoi>
# ------------------------------------------------------------
SEPAY_ENABLED=1
# Ma ngan hang viet tat dung cho QR: ACB, VCB, TCB, MB, BIDV, VPB, TPB...
SEPAY_BANK_CODE=TCB
SEPAY_BANK_NAME=Techcombank
SEPAY_ACCOUNT_NUMBER=688840
# Dien DUNG ten chu tai khoan nhu dang ky voi ngan hang
SEPAY_ACCOUNT_NAME=CONG TY TNHH MIEN TAY MEDIA
# Chuoi bi mat BAN tu dat, phai trung voi header Apikey khai bao tren SePay
SEPAY_WEBHOOK_TOKEN=
# API Token (my.sepay.vn > API Token) - dung de doi soat bu khi webhook that lac
SEPAY_API_TOKEN=

# ------------------------------------------------------------
#  THANH TOAN - MOMO (AIO v2)
# ------------------------------------------------------------
MOMO_ENABLED=0
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ------------------------------------------------------------
#  THANH TOAN - ZALOPAY (v2)
# ------------------------------------------------------------
ZALOPAY_ENABLED=0
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create

# ------------------------------------------------------------
#  TAI KHOAN QUAN TRI KHOI TAO (chi dung luc chay `npm run seed`)
# ------------------------------------------------------------
ADMIN_EMAIL=EM@mientaymedia.com
ADMIN_PASSWORD=doi_mat_khau_nay_ngay

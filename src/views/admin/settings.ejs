<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Cấu hình Control Panel</h1>
  <%- include('../partials/admin-nav') %>

  <div class="alert alert-info">
    Các giá trị ở đây <strong>ghi đè</strong> cấu hình trong file <code>.env</code> và có hiệu lực ngay khi lưu,
    không cần khởi động lại server. Ô nhập bí mật hiển thị dạng che (<code>abcd****wxyz</code>) - để trống nếu không đổi.
  </div>

  <form method="post" action="<%= base %>/admin/cau-hinh">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <%
      var groups = [
        { key: 'site.',    title: 'Thương hiệu website', note: 'Tên, màu sắc và thông tin liên hệ hiện trên toàn bộ site và email.' },
        { key: 'pa.',      title: 'API đại lý P.A Việt Nam', note: 'API chỉ chấp nhận request từ IP đã đăng ký whitelist với P.A. API Key đổi khi bạn đổi mật khẩu tài khoản đại lý.' },
        { key: 'dns.',     title: 'DNS mặc định', note: 'Nameserver gán cho tên miền ngay khi đăng ký thành công.' },
        { key: 'pricing.', title: 'Chính sách giá', note: 'Áp dụng cho toàn bộ bảng giá: giá bán = giá gốc + markup, làm tròn lên bội số, cộng VAT.' },
        { key: 'order.',   title: 'Quy trình đơn hàng', note: 'Tự động đăng ký sau thanh toán, thời gian giữ đơn, mốc nhắc gia hạn.' },
        { key: 'sepay.',   title: 'Thanh toán chuyển khoản (SePay)', note: '' },
        { key: 'momo.',    title: 'Ví MoMo', note: '' },
        { key: 'zalopay.', title: 'ZaloPay', note: '' },
        { key: 'security.', title: 'Bảo mật quản trị', note: 'Tài khoản quản trị nắm API key P.A (tiêu tiền thật), token cổng thanh toán và dữ liệu cá nhân của khách.' },
        { key: 'oauth.',   title: 'Đăng nhập bằng mạng xã hội', note: 'Khách đăng nhập, đăng ký bằng Zalo, Google, GitHub. Bên nào thiếu khóa thì nút của bên đó không hiện. Khóa bí mật lưu mã hóa.' },
        { key: 'auth.',    title: 'Xác thực tài khoản', note: 'Email là kênh giao thông tin quản trị tên miền - email sai đồng nghĩa khách mất liên lạc với tài sản của họ.' },
        { key: 'smtp.',    title: 'Email (Resend hoặc SMTP)', note: 'Dùng để gửi email xác thực, thông tin quản trị tên miền, nhắc gia hạn và cảnh báo nội bộ.' },
        { key: 'zns.',     title: 'Zalo ZNS', note: 'Gửi thông báo qua Zalo Official Account. Cần duyệt mẫu tin trước khi gửi được.' },
        { key: 'tg.',      title: 'Telegram quản trị', note: 'Báo đơn mới, đăng ký xong, thiếu quỹ đại lý và lỗi cần xử lý; nhận lệnh /kichhoat, /sodu, /doncho.' },
        { key: 'crm.',     title: 'Đồng bộ CRM', note: 'Đẩy sự kiện đơn hàng sang CRM. CRM gọi ngược web qua cổng nội bộ bằng WEB_TEN_MIEN_KEY.' },
        { key: 'ai.',      title: 'Tìm cùng AI (OpenAI)', note: 'Khách mô tả ý tưởng, AI gợi ý tên, hệ thống kiểm tra thật qua P.A. Không lưu nguyên văn mô tả của khách; thống kê theo ngày xem ở trang Tổng quan.' }
      ];
    %>

    <% groups.forEach(function (g) { %>
      <div class="card">
        <div class="card-title"><h2><%= g.title %></h2></div>
        <% if (g.note) { %><p class="muted small" style="margin-top:-6px"><%= g.note %></p><% } %>

        <% if (g.key === 'sepay.') { %>
          <div class="alert alert-info small">
            <strong>Cách thiết lập:</strong> đăng nhập <a href="https://my.sepay.vn" target="_blank" rel="noopener">my.sepay.vn</a>,
            liên kết tài khoản ngân hàng, rồi tạo Webhook với:
            <div class="copy-row" style="margin-top:8px">
              <span class="label">URL</span>
              <span class="value"><%= webhookUrl %> <button type="button" class="btn-link tiny" data-copy="<%= webhookUrl %>">chép</button></span>
            </div>
            <div class="copy-row">
              <span class="label">Header</span>
              <span class="value">Authorization: Apikey &lt;token bên dưới&gt;</span>
            </div>
          </div>
        <% } %>

        <% if (g.key === 'oauth.') { %>
          <div class="alert alert-info small">
            <strong>Địa chỉ quay về (redirect URI)</strong> phải khai báo đúng từng ký tự ở trang developer của từng bên:
            <% oauthCallbacks.forEach(function (c) { %>
              <div class="copy-row" style="margin-top:8px">
                <span class="label"><%= c.ben === 'zalo' ? 'Zalo' : c.ben === 'google' ? 'Google' : 'GitHub' %></span>
                <span class="value"><%= c.url %> <button type="button" class="btn-link tiny" data-copy="<%= c.url %>">chép</button></span>
              </div>
            <% }); %>
          </div>
        <% } %>

        <div class="grid grid-2" style="gap:0 16px">
          <% fields.filter(function (f) { return f.key.indexOf(g.key) === 0; }).forEach(function (f) { %>
            <% if (f.type === 'checkbox') { %>
              <div class="field">
                <label class="check">
                  <input type="checkbox" name="<%= f.key %>" value="1" <%= values[f.key] === '1' ? 'checked' : '' %>>
                  <span><%= f.label %></span>
                </label>
                <% if (f.hint) { %><div class="hint"><%= f.hint %></div><% } %>
              </div>
            <% } else if (f.type === 'textarea') { %>
              <div class="field" style="grid-column:1 / -1">
                <label for="<%= f.key %>"><%= f.label %></label>
                <textarea id="<%= f.key %>" name="<%= f.key %>" rows="4"><%= values[f.key] || '' %></textarea>
                <% if (f.hint) { %><div class="hint"><%= f.hint %></div><% } %>
              </div>
            <% } else { %>
              <div class="field">
                <label for="<%= f.key %>"><%= f.label %></label>
                <input id="<%= f.key %>" type="<%= f.type === 'number' ? 'number' : 'text' %>"
                       name="<%= f.key %>"
                       value="<%= values[f.key] || '' %>"
                       <%= secretKeys.indexOf(f.key) >= 0 ? 'autocomplete="off"' : '' %>>
                <% if (f.hint) { %><div class="hint"><%= f.hint %></div><% } %>
                <% if (secretKeys.indexOf(f.key) >= 0) { %><div class="hint">Giá trị bí mật - để nguyên nếu không đổi.</div><% } %>
              </div>
            <% } %>
          <% }); %>
        </div>

        <% if (g.key === 'sepay.' && qrPreview) { %>
          <h3 class="section-heading">Xem thử mã QR (10.000 đ - nội dung DHTEST01)</h3>
          <div class="qr-box" style="max-width:280px"><img src="<%= qrPreview %>" alt="QR thử"></div>
        <% } %>
      </div>
    <% }); %>

    <div class="card">
      <div class="row-between">
        <span class="muted small">Lưu để áp dụng toàn bộ thay đổi phía trên.</span>
        <button class="btn btn-lg" type="submit">Lưu cấu hình</button>
      </div>
    </div>
  </form>

  <div class="card">
    <div class="card-title"><h2>Gửi thử email (kiểm tra SMTP)</h2></div>
    <p class="muted small">Gửi một email thật để xác nhận host, port, tài khoản và mật khẩu ứng dụng đã đúng.</p>
    <form method="post" action="<%= base %>/admin/cau-hinh/kiem-tra-smtp">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row" style="align-items:flex-end">
        <div class="field" style="flex:1; margin:0">
          <label><span class="field-name">Gửi tới địa chỉ</span>
          <input type="email" name="test_email" value="<%= currentUser.email %>" required></label>
        </div>
        <button class="btn btn-outline" type="submit">Gửi email thử</button>
      </div>
    </form>
    <div class="alert alert-info tiny" style="margin:14px 0 0">
      <strong>Dùng Gmail?</strong> Username phải là <u>địa chỉ email đầy đủ</u> (vd
      <code>hello@mientaymedia.com</code>), không phải tên tài khoản. Và địa chỉ ở ô
      <em>From Mail</em> phải được khai báo sẵn trong Gmail (Settings &rarr; Accounts &rarr;
      "Send mail as") - nếu không Gmail sẽ tự đổi người gửi thành địa chỉ thật, làm email
      dễ rơi vào spam.
    </div>
  </div>

  <div class="card">
    <div class="card-title">
      <h2>Mẫu tin ZNS</h2>
      <span class="badge <%= znsReady ? 'badge-ok' : 'badge-muted' %>"><%= znsReady ? 'Đã sẵn sàng' : 'Chưa cấu hình' %></span>
    </div>
    <p class="muted small">
      Tạo mẫu tin tại <a href="https://business.zalo.me" target="_blank" rel="noopener">business.zalo.me</a>,
      chờ Zalo duyệt, rồi dán template ID vào đây. <strong>Tên tham số của mẫu phải đúng y như cột "Tham số"</strong> -
      sai tên thì Zalo trả lỗi <code>-213</code>.
    </p>

    <form method="post" action="<%= base %>/admin/cau-hinh/zns-template">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Sự kiện</th><th style="width:170px">Template ID</th><th>Tham số bắt buộc</th><th>Gợi ý nội dung</th></tr></thead>
          <tbody>
            <% znsEvents.forEach(function (e) { %>
              <tr>
                <td><strong><%= e.label %></strong><div class="tiny muted mono"><%= e.event %></div></td>
                <td><input type="text" name="<%= e.settingKey %>" value="<%= e.templateId %>" placeholder="vd 123456" aria-label="Template ID cho sự kiện <%= e.label %>"></td>
                <td class="tiny mono"><%= e.params.join(', ') %></td>
                <td class="tiny muted"><%= e.sample %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <button class="btn" type="submit" style="margin-top:14px">Lưu template ID</button>
    </form>
  </div>

  <div class="card">
    <div class="card-title"><h2>Gửi thử ZNS</h2></div>
    <p class="muted small">
      Zalo chỉ gửi được tới số đã từng tương tác với Official Account của bạn và chưa chặn OA.
    </p>
    <form method="post" action="<%= base %>/admin/cau-hinh/kiem-tra-zns">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row" style="align-items:flex-end">
        <div class="field" style="width:200px; margin:0">
          <label><span class="field-name">Số điện thoại</span>
          <input type="text" name="test_phone" placeholder="0901234567" required></label>
        </div>
        <div class="field" style="flex:1; margin:0">
          <label><span class="field-name">Dùng mẫu của sự kiện</span>
          <select name="test_event"></label>
            <% znsEvents.forEach(function (e) { %>
              <option value="<%= e.event %>" <%= e.event === 'domain_activated' ? 'selected' : '' %>><%= e.label %></option>
            <% }); %>
          </select>
        </div>
        <button class="btn btn-outline" type="submit">Gửi ZNS thử</button>
      </div>
    </form>
    <p class="tiny muted" style="margin:10px 0 0">Kết quả chi tiết xem tại <a href="<%= base %>/admin/zns">Nhật ký ZNS</a>.</p>
  </div>

  <div class="card">
    <div class="card-title"><h2>Kiểm tra kết nối API P.A</h2></div>
    <p class="muted small">Gọi lệnh chỉ đọc <code>check_account_still</code> (số dư đại lý) để xác nhận username, API Key và IP whitelist đã đúng. Nhập tên miền nếu muốn kiểm thêm <code>check_whois</code>.</p>
    <form method="post" action="<%= base %>/admin/cau-hinh/kiem-tra-api">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="row" style="align-items:flex-end">
        <div class="field" style="flex:1; margin:0">
          <label><span class="field-name">Tên miền để thử (không bắt buộc)</span>
          <input type="text" name="test_domain" value=""></label>
        </div>
        <button class="btn btn-outline" type="submit">Kiểm tra ngay</button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>

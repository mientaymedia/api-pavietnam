<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Nhat ky ZNS</h1>
  <%- include('../partials/admin-nav') %>

  <div class="card">
    <div class="card-title">
      <h2>Ket noi Zalo Official Account</h2>
      <span class="badge <%= daKetNoi ? 'badge-ok' : 'badge-warn' %>"><%= daKetNoi ? 'Da ket noi' : 'Chua ket noi' %></span>
    </div>

    <% if (!coAppId) { %>
      <p class="muted small">
        Buoc 1: vao <a href="/admin/cau-hinh">Cau hinh Control Panel</a> dien <strong>App ID</strong> va
        <strong>Secret Key</strong> lay tu developers.zalo.me, roi quay lai day.
      </p>
    <% } else { %>
      <p class="muted small">
        Bam nut duoi day, Zalo se hoi ban cho phep ung dung truy cap Official Account.
        Cho phep xong, he thong <strong>tu lay va tu duy tri token</strong> - ban khong phai
        sao chep refresh token bang tay, cung khong phai lam lai dinh ky.
      </p>
      <div class="copy-row" style="margin-bottom:12px">
        <span class="label">Dia chi callback (khai bao trong Zalo neu duoc hoi)</span>
        <span class="value"><%= callbackUrl %>
          <button type="button" class="btn-link tiny" data-copy="<%= callbackUrl %>">chep</button></span>
      </div>
      <a class="btn" href="/admin/zns/ket-noi"><%= daKetNoi ? 'Ket noi lai' : 'Ket noi Zalo OA' %></a>
      <% if (daKetNoi) { %>
        <p class="tiny muted" style="margin:10px 0 0">
          Chi ket noi lai khi token bi hong (Nhat ky bao loi -124/-125 lien tuc)
          hoac khi doi sang Official Account khac.
        </p>
      <% } %>
    <% } %>
  </div>

  <% if (!ready) { %>
    <div class="alert alert-warn">
      ZNS chua san sang. Can du ba thu: <strong>bat ZNS</strong>, <strong>App ID + Secret Key</strong>,
      va <strong>ket noi Zalo OA</strong> o tren. Sau do khai template ID cho tung su kien
      trong <a href="/admin/cau-hinh">Cau hinh Control Panel</a>.
    </div>
  <% } %>

  <div class="card">
    <p class="muted small">
      Moi lan gui deu duoc ghi lai, ke ca truong hop bi bo qua (khach khong co so dien thoai,
      chua khai template ID). Xem cot <em>Ket qua</em> de biet ly do.
    </p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Thoi gian</th><th>Su kien</th><th>So dien thoai</th><th>Template</th><th>Ket qua</th><th>Ghi chu</th></tr>
        </thead>
        <tbody>
          <% if (!logs.length) { %>
            <tr><td colspan="6" class="muted center">Chua gui tin ZNS nao.</td></tr>
          <% } %>
          <% logs.forEach(function (l) { %>
            <tr>
              <td class="small nowrap"><%= l.created_at.replace('T', ' ').slice(0, 16) %></td>
              <td class="small mono"><%= l.event %></td>
              <td class="mono small"><%= l.phone %></td>
              <td class="tiny mono muted"><%= l.template_id || '-' %></td>
              <td>
                <span class="badge <%= l.status === 'sent' ? 'badge-ok' : l.status === 'skipped' ? 'badge-muted' : 'badge-danger' %>">
                  <%= l.status === 'sent' ? 'Da gui' : l.status === 'skipped' ? 'Bo qua' : 'That bai' %>
                </span>
                <% if (l.msg_id) { %><div class="tiny muted mono"><%= l.msg_id %></div><% } %>
              </td>
              <td class="tiny" style="max-width:320px; word-break:break-word; color:<%= l.status === 'failed' ? 'var(--danger)' : 'var(--ink-soft)' %>">
                <%= l.error %><% if (l.error_code) { %> <span class="muted">[<%= l.error_code %>]</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

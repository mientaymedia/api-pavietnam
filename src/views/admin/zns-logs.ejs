<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Nhật ký ZNS</h1>
  <%- include('../partials/admin-nav') %>

  <div class="card">
    <div class="card-title">
      <h2>Kết nối Zalo Official Account</h2>
      <span class="badge <%= daKetNoi ? 'badge-ok' : 'badge-warn' %>"><%= daKetNoi ? 'Đã kết nối' : 'Chưa kết nối' %></span>
    </div>

    <% if (!coAppId) { %>
      <p class="muted small">
        Bước 1: vào <a href="<%= base %>/admin/cau-hinh">Cấu hình Control Panel</a> điền <strong>App ID</strong> và
        <strong>Secret Key</strong> lấy từ developers.zalo.me, rồi quay lại đây.
      </p>
    <% } else { %>
      <p class="muted small">
        Bấm nút dưới đây, Zalo sẽ hỏi bạn cho phép ứng dụng truy cập Official Account.
        Cho phép xong, hệ thống <strong>tự lấy và tự duy trì token</strong> - bạn không phải
        sao chép refresh token bằng tay, cũng không phải làm lại định kỳ.
      </p>
      <div class="copy-row" style="margin-bottom:12px">
        <span class="label">Địa chỉ callback (khai báo trong Zalo nếu được hỏi)</span>
        <span class="value"><%= callbackUrl %>
          <button type="button" class="btn-link tiny" data-copy="<%= callbackUrl %>">chép</button></span>
      </div>
      <a class="btn" href="<%= base %>/admin/zns/ket-noi"><%= daKetNoi ? 'Kết nối lại' : 'Kết nối Zalo OA' %></a>
      <% if (daKetNoi) { %>
        <p class="tiny muted" style="margin:10px 0 0">
          Chỉ kết nối lại khi token bị hỏng (Nhật ký báo lỗi -124/-125 liên tục)
          hoặc khi đổi sang Official Account khác.
        </p>
      <% } %>
    <% } %>
  </div>

  <% if (!ready) { %>
    <div class="alert alert-warn">
      ZNS chưa sẵn sàng. Cần đủ ba thứ: <strong>bật ZNS</strong>, <strong>App ID + Secret Key</strong>,
      và <strong>kết nối Zalo OA</strong> ở trên. Sau đó khai template ID cho từng sự kiện
      trong <a href="<%= base %>/admin/cau-hinh">Cấu hình Control Panel</a>.
    </div>
  <% } %>

  <div class="card">
    <p class="muted small">
      Mỗi lần gửi đều được ghi lại, kể cả trường hợp bị bỏ qua (khách không có số điện thoại,
      chưa khai template ID). Xem cột <em>Kết quả</em> để biết lý do.
    </p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Thời gian</th><th>Sự kiện</th><th>Số điện thoại</th><th>Template</th><th>Kết quả</th><th>Ghi chú</th></tr>
        </thead>
        <tbody>
          <% if (!logs.length) { %>
            <tr><td colspan="6" class="muted center">Chưa gửi tin ZNS nào.</td></tr>
          <% } %>
          <% logs.forEach(function (l) { %>
            <tr>
              <td class="small nowrap"><%= l.created_at.replace('T', ' ').slice(0, 16) %></td>
              <td class="small mono"><%= l.event %></td>
              <td class="mono small"><%= l.phone %></td>
              <td class="tiny mono muted"><%= l.template_id || '-' %></td>
              <td>
                <span class="badge <%= l.status === 'sent' ? 'badge-ok' : l.status === 'skipped' ? 'badge-muted' : 'badge-danger' %>">
                  <%= l.status === 'sent' ? 'Đã gửi' : l.status === 'skipped' ? 'Bỏ qua' : 'Thất bại' %>
                </span>
                <% if (l.msg_id) { %><div class="tiny muted mono"><%= l.msg_id %></div><% } %>
              </td>
              <td class="tiny" style="max-width:320px; word-break:break-word; color:<%= l.status === 'failed' ? 'var(--danger)' : 'var(--ink-soft)' %>">
                <%= l.error %><% if (l.error_code) { %> <span class="muted">[<%= l.error_code %>]</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

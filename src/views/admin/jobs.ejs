<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Hàng đợi xử lý</h1>
  <%- include('../partials/admin-nav') %>

  <div class="grid grid-4">
    <div class="stat"><div class="stat-value"><%= stats.queued %></div><div class="stat-label">Đang chờ</div></div>
    <div class="stat"><div class="stat-value"><%= stats.running %></div><div class="stat-label">Đang chạy</div></div>
    <div class="stat"><div class="stat-value"><%= stats.done %></div><div class="stat-label">Hoàn tất</div></div>
    <div class="stat"><div class="stat-value" style="color:<%= stats.failed ? 'var(--danger)' : 'inherit' %>"><%= stats.failed %></div><div class="stat-label">Thất bại</div></div>
  </div>

  <div class="card" style="margin-top:18px">
    <div class="card-title"><h2>Chạy tác vụ định kỳ ngay</h2></div>
    <div class="row">
      <% ['send_renewal_reminders', 'auto_renew_domains', 'expire_stale_orders', 'reconcile_sepay', 'sync_domains_due'].forEach(function (t) { %>
        <form method="post" action="<%= base %>/admin/hang-doi/chay-ngay">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="type" value="<%= t %>">
          <button class="btn btn-sm btn-outline" type="submit"><%= t %></button>
        </form>
      <% }); %>
    </div>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Loại</th><th>Dữ liệu</th><th>Trạng thái</th><th>Lần thử</th><th>Lỗi gần nhất</th><th></th></tr></thead>
        <tbody>
          <% jobs.forEach(function (j) { %>
            <tr>
              <td class="tiny muted"><%= j.id %></td>
              <td class="small"><strong><%= j.type %></strong></td>
              <td class="tiny mono muted"><%= JSON.stringify(j.payloadObj) %></td>
              <td>
                <span class="badge <%= j.status === 'done' ? 'badge-ok' : j.status === 'failed' ? 'badge-danger' : j.status === 'running' ? 'badge-info' : 'badge-warn' %>"><%= j.status %></span>
              </td>
              <td class="small"><%= j.attempts %></td>
              <td class="tiny" style="max-width:280px; word-break:break-all; color:var(--danger)"><%= j.last_error %></td>
              <td class="right">
                <% if (j.status === 'failed') { %>
                  <form method="post" action="<%= base %>/admin/hang-doi/<%= j.id %>/chay-lai">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-outline" type="submit">Chạy lại</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

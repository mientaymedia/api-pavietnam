<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Quan ly khach hang</h1>
  <%- include('../partials/admin-nav') %>

  <div class="card">
    <form method="get" action="/admin/nguoi-dung" style="margin-bottom:14px">
      <div class="row">
        <div style="flex:1"><input type="search" name="q" value="<%= q %>" aria-label="Tim khach hang" placeholder="Tim theo email hoac ten"></div>
        <button class="btn btn-outline" type="submit">Tim</button>
      </div>
    </form>

    <div class="table-wrap">
      <table>
        <thead><tr><th>Khach hang</th><th>Vai tro</th><th class="right">So du</th><th>Trang thai</th><th style="width:280px">Thao tac</th></tr></thead>
        <tbody>
          <% users.forEach(function (u) { %>
            <tr>
              <td>
                <strong><%= u.full_name || '(chua dat ten)' %></strong>
                <div class="tiny muted"><%= u.email %><% if (u.phone) { %> &middot; <%= u.phone %><% } %></div>
              </td>
              <td><span class="badge <%= u.role === 'admin' ? 'badge-info' : 'badge-muted' %>"><%= u.role %></span></td>
              <td class="right"><%= formatVnd(u.balance) %></td>
              <td><span class="badge <%= u.status === 'active' ? 'badge-ok' : 'badge-danger' %>"><%= u.status %></span></td>
              <td>
                <form method="post" action="/admin/nguoi-dung/<%= u.id %>/nap-vi" class="row" style="gap:6px; margin-bottom:6px">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="number" name="amount" aria-label="So tien cong hoac tru" placeholder="So tien" style="width:110px" required>
                  <input type="text" name="note" aria-label="Ghi chu bien dong so du" placeholder="Ghi chu" style="width:100px">
                  <button class="btn btn-sm" type="submit">Cong/Tru</button>
                </form>
                <form method="post" action="/admin/nguoi-dung/<%= u.id %>/trang-thai"
                      data-confirm="<%= u.status === 'active' ? 'Khoa tai khoan nay?' : 'Mo khoa tai khoan nay?' %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="status" value="<%= u.status === 'active' ? 'suspended' : 'active' %>">
                  <button class="btn-link tiny" type="submit"><%= u.status === 'active' ? 'Khoa tai khoan' : 'Mo khoa' %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Quản lý khách hàng</h1>
  <%- include('../partials/admin-nav') %>

  <div class="card">
    <form method="get" action="<%= base %>/admin/nguoi-dung" style="margin-bottom:14px">
      <div class="row">
        <div style="flex:1"><input type="search" name="q" value="<%= q %>" aria-label="Tìm khách hàng" placeholder="Tìm theo email hoặc tên"></div>
        <button class="btn btn-outline" type="submit">Tìm</button>
      </div>
    </form>

    <div class="table-wrap">
      <table>
        <thead><tr><th>Khách hàng</th><th>Vai trò</th><th class="right">Số dư</th><th>Trạng thái</th><th style="width:280px">Thao tác</th></tr></thead>
        <tbody>
          <% users.forEach(function (u) { %>
            <tr>
              <td>
                <strong><%= u.full_name || '(chưa đặt tên)' %></strong>
                <div class="tiny muted"><%= u.email %><% if (u.phone) { %> &middot; <%= u.phone %><% } %></div>
              </td>
              <td><span class="badge <%= u.role === 'admin' ? 'badge-info' : 'badge-muted' %>"><%= u.role %></span></td>
              <td class="right"><%= formatVnd(u.balance) %></td>
              <td><span class="badge <%= u.status === 'active' ? 'badge-ok' : 'badge-danger' %>"><%= u.status %></span></td>
              <td>
                <form method="post" action="<%= base %>/admin/nguoi-dung/<%= u.id %>/nap-vi" class="row" style="gap:6px; margin-bottom:6px">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="number" name="amount" aria-label="Số tiền cộng hoặc trừ" placeholder="Số tiền" style="width:110px" required>
                  <input type="text" name="note" aria-label="Ghi chú biến động số dư" placeholder="Ghi chú" style="width:100px">
                  <button class="btn btn-sm" type="submit">Cộng/Trừ</button>
                </form>
                <form method="post" action="<%= base %>/admin/nguoi-dung/<%= u.id %>/trang-thai"
                      data-confirm="<%= u.status === 'active' ? 'Khóa tài khoản này?' : 'Mở khóa tài khoản này?' %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="status" value="<%= u.status === 'active' ? 'suspended' : 'active' %>">
                  <button class="btn-link tiny" type="submit"><%= u.status === 'active' ? 'Khóa tài khoản' : 'Mở khóa' %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

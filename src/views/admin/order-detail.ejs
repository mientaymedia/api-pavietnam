<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Đơn hàng <span class="mono"><%= order.code %></span></h1>
  <%- include('../partials/admin-nav') %>

  <div class="sidebar-layout">
    <div>
      <div class="card">
        <div class="card-title">
          <h2>Các dòng đơn hàng</h2>
          <%- include('../partials/order-status', { status: order.status }) %>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Tên miền</th><th>Dịch vụ</th><th>Năm</th><th>Trạng thái</th><th>Mã tham chiếu</th><th class="right">Tiền</th></tr></thead>
            <tbody>
              <% items.forEach(function (i) { %>
                <tr>
                  <td class="mono"><strong><%= i.domain %></strong></td>
                  <td class="small"><%= i.action %></td>
                  <td class="small"><%= i.years %></td>
                  <td>
                    <span class="badge <%= i.status === 'active' ? 'badge-ok' : i.status === 'failed' ? 'badge-danger' : i.status === 'refunded' ? 'badge-info' : 'badge-muted' %>">
                      <%= i.status === 'refunded' ? 'đã hoàn tiền' : i.status %>
                    </span>
                    <% if (i.error) { %><div class="tiny" style="color:var(--danger)"><%= i.error %></div><% } %>
                    <% if (i.attempts) { %><div class="tiny muted">Đã thử <%= i.attempts %> lần</div><% } %>
                    <% if (i.status === 'failed') { %>
                      <form method="post" action="<%= base %>/admin/don-hang/<%= order.id %>/hoan-tien/<%= i.id %>"
                            data-confirm="Hoàn tiền dòng này vào số dư khách hàng?" style="margin-top:6px">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-sm btn-outline" type="submit">Hoàn tiền vào ví</button>
                      </form>
                    <% } %>
                  </td>
                  <td class="tiny mono muted"><%= i.provider_ref || '-' %></td>
                  <td class="right"><%= formatVnd(i.amount) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-title"><h2>Giao dịch thanh toán</h2></div>
        <% if (!payments.length) { %>
          <p class="muted small">Chưa có giao dịch nào.</p>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Thời gian</th><th>Cổng</th><th>Mã tham chiếu</th><th>Mã GD</th><th>Trạng thái</th><th class="right">Tiền</th></tr></thead>
              <tbody>
                <% payments.forEach(function (p) { %>
                  <tr>
                    <td class="small"><%= p.created_at.replace('T', ' ').slice(0, 16) %></td>
                    <td><span class="badge badge-muted"><%= p.provider %></span></td>
                    <td class="mono tiny"><%= p.ref_code %></td>
                    <td class="mono tiny"><%= p.provider_txn || '-' %></td>
                    <td><span class="badge <%= p.status === 'paid' ? 'badge-ok' : p.status === 'pending' ? 'badge-warn' : 'badge-muted' %>"><%= p.status %></span></td>
                    <td class="right"><%= formatVnd(p.amount) %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <aside>
      <div class="card">
        <div class="card-title"><h3>Khách hàng</h3></div>
        <% if (customer) { %>
          <div class="copy-row"><span class="label">Họ tên</span><span class="value small"><%= customer.full_name %></span></div>
          <div class="copy-row"><span class="label">Email</span><span class="value small"><%= customer.email %></span></div>
          <div class="copy-row"><span class="label">Điện thoại</span><span class="value small"><%= customer.phone %></span></div>
        <% } %>
        <div class="copy-row"><span class="label">IP đặt hàng</span><span class="value small"><%= order.ip || '-' %></span></div>
        <% if (order.note) { %><div class="copy-row"><span class="label">Ghi chú</span><span class="value small"><%= order.note %></span></div><% } %>
      </div>

      <div class="card">
        <div class="card-title"><h3>Thao tác</h3></div>

        <% if (order.status === 'pending_payment') { %>
          <form method="post" action="<%= base %>/admin/don-hang/<%= order.id %>/xac-nhan-thanh-toan"
                data-confirm="Xác nhận đã nhận đủ <%= formatVnd(order.total) %> cho đơn này? Hệ thống sẽ đăng ký tên miền ngay.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label><span class="field-name">Ghi chú đối soát</span><input type="text" name="note" placeholder="VD: CK Techcombank lúc 10:23"></label></div>
            <button class="btn btn-block" type="submit">Xác nhận đã thanh toán</button>
          </form>
          <p class="tiny muted" style="margin-top:8px">Dùng khi khách đã chuyển khoản nhưng webhook không đối soát được.</p>
        <% } %>

        <% var soDongThatBai = items.filter(function (i) { return i.status === 'failed'; }).length; %>
        <% if (soDongThatBai > 1) { %>
          <form method="post" action="<%= base %>/admin/don-hang/<%= order.id %>/hoan-tien-tat-ca"
                data-confirm="Hoàn tiền <%= soDongThatBai %> dòng đã thất bại?" style="margin-top:12px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label><span class="field-name">Lý do hoàn tiền</span><input type="text" name="reason" placeholder="VD: tên miền đã có người đăng ký"></label></div>
            <button class="btn btn-outline btn-block" type="submit">Hoàn tiền tất cả (<%= soDongThatBai %> dòng)</button>
          </form>
        <% } %>

        <% if (['paid','processing','failed','partially_completed'].indexOf(order.status) >= 0) { %>
          <form method="post" action="<%= base %>/admin/don-hang/<%= order.id %>/cap-phat-lai"
                data-confirm="Chạy lại cấp phát cho các dòng thất bại?" style="margin-top:12px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-outline btn-block" type="submit">Chạy lại cấp phát</button>
          </form>
        <% } %>

        <div style="margin-top:14px; padding-top:14px; border-top:1px solid var(--line)">
          <div class="copy-row"><span class="label">Tạm tính</span><span class="value"><%= formatVnd(order.subtotal) %></span></div>
          <% if (order.discount) { %><div class="copy-row"><span class="label">Giảm giá</span><span class="value">-<%= formatVnd(order.discount) %></span></div><% } %>
          <% if (order.vat) { %><div class="copy-row"><span class="label">VAT</span><span class="value"><%= formatVnd(order.vat) %></span></div><% } %>
          <div class="copy-row"><span class="label"><strong>Tổng</strong></span><span class="value"><%= formatVnd(order.total) %></span></div>
        </div>
      </div>
    </aside>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Quản trị hệ thống</h1>
  <%- include('../partials/admin-nav') %>

  <div class="card">
    <div class="card-title"><h2>Tài khoản đại lý P.A</h2><a class="small" href="<%= base %>/admin/cho-xu-ly">Đơn chờ xử lý</a></div>
    <p class="small" style="margin:0">
      Chế độ: <span class="badge <%= paCheDo.ma === 'that' ? 'badge-ok' : 'badge-warn' %>"><%= paCheDo.ma === 'that' ? 'Thật' : paCheDo.ma === 'thu' ? 'Thử' : 'Giả lập' %></span>
      &middot; Số dư:
      <% if (paSoDu.soDu === null) { %>
        <strong style="color:var(--danger)">không đọc được</strong> <span class="muted"><%= paSoDu.loiSoDu %></span>
      <% } else { %>
        <strong><%= formatVnd(paSoDu.soDu) %></strong>
      <% } %>
    </p>
    <p class="small" style="margin:8px 0 0">
      Chờ nạp quỹ: <strong style="color:<%= dongGiu.choQuy ? 'var(--warn)' : 'inherit' %>"><%= dongGiu.choQuy %></strong>
      <% if (paSoDu.canNap) { %>(cần nạp thêm <strong><%= formatVnd(paSoDu.canNap) %></strong>)<% } %>
      &middot; Cần người xử lý: <strong style="color:<%= dongGiu.canNguoi ? 'var(--danger)' : 'inherit' %>"><%= dongGiu.canNguoi %></strong>
      &middot; Hồ sơ cần sửa: <strong style="color:<%= dongGiu.saiHoSo ? 'var(--warn)' : 'inherit' %>"><%= dongGiu.saiHoSo %></strong>
    </p>
  </div>

  <div class="grid grid-3">
    <div class="stat"><div class="stat-value"><%= stats.users %></div><div class="stat-label">Khách hàng</div></div>
    <div class="stat"><div class="stat-value"><%= stats.activeDomains %>/<%= stats.domains %></div><div class="stat-label">Tên miền đang hoạt động</div></div>
    <div class="stat"><div class="stat-value"><%= formatVnd(stats.revenue) %></div><div class="stat-label">Doanh thu đã thanh toán</div></div>
    <div class="stat"><div class="stat-value" style="color:var(--warn)"><%= stats.pendingOrders %></div><div class="stat-label">Đơn chờ thanh toán</div></div>
    <div class="stat"><div class="stat-value" style="color:<%= stats.failedItems ? 'var(--danger)' : 'inherit' %>"><%= stats.failedItems %></div><div class="stat-label">Dòng đơn thất bại</div></div>
    <div class="stat">
      <div class="stat-value" style="color:<%= stats.ownershipPending ? 'var(--warn)' : 'inherit' %>"><%= stats.ownershipPending %></div>
      <div class="stat-label"><a href="<%= base %>/admin/doi-chu-the">Hồ sơ đổi chủ thể chờ xử lý</a></div>
    </div>
    <div class="stat">
      <div class="stat-value"><%= jobs.queued %></div>
      <div class="stat-label">Job đang chờ<% if (jobs.failed) { %> &middot; <span style="color:var(--danger)"><%= jobs.failed %> lỗi</span><% } %></div>
    </div>
  </div>

  <div class="grid grid-2" style="margin-top:18px">
    <div class="card">
      <div class="card-title"><h2>Đơn hàng mới</h2><a class="small" href="<%= base %>/admin/don-hang">Tất cả</a></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Mã đơn</th><th>Trạng thái</th><th class="right">Tiền</th></tr></thead>
          <tbody>
            <% recentOrders.forEach(function (o) { %>
              <tr>
                <td><a class="mono" href="<%= base %>/admin/don-hang/<%= o.id %>"><%= o.code %></a></td>
                <td><%- include('../partials/order-status', { status: o.status }) %></td>
                <td class="right"><%= formatVnd(o.total) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-title"><h2>Lỗi API gần đây</h2><a class="small" href="<%= base %>/admin/nhat-ky-api?loi=1">Tất cả</a></div>
      <% if (!recentErrors.length) { %>
        <p class="muted small">Không có lỗi nào. Hệ thống đang kết nối tốt.</p>
      <% } else { %>
        <% recentErrors.forEach(function (l) { %>
          <div style="padding:8px 0; border-bottom:1px solid var(--line)">
            <div class="small"><strong><%= l.action %></strong> <span class="muted"><%= l.domain %></span></div>
            <div class="tiny muted" style="word-break:break-all"><%= l.response.slice(0, 160) %></div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <%
    // Tim cung AI: chi so dem an danh theo ngay (gio Viet Nam), khong co mo ta cua khach
    var AI_TRANG_THAI = {
      'san-sang': ['badge-ok', 'Đang bật'],
      'tat': ['badge-muted', 'Đang tắt'],
      'thieu-cau-hinh': ['badge-warn', 'Đã bật nhưng thiếu khóa hoặc tên model'],
      'cham-tran': ['badge-danger', 'Chạm trần chi phí hôm nay, tự chạy lại vào ngày mai']
    };
    var aiNhan = AI_TRANG_THAI[ai.trangThai];
  %>
  <div class="card" style="margin-top:18px">
    <div class="card-title"><h2>Tìm cùng AI</h2><a class="small" href="<%= base %>/admin/cau-hinh">Cấu hình</a></div>
    <p class="small">
      <span class="badge <%= aiNhan[0] %>"><%= aiNhan[1] %></span>
      Chi phí ước tính hôm nay: <strong><%= formatVnd(Math.round(ai.chiPhiHomNay)) %></strong> trên trần <%= formatVnd(ai.tran) %>.
    </p>
    <% if (!ai.thongKe.length) { %>
      <p class="muted small">Chưa có lượt gợi ý nào.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr>
            <th>Ngày</th><th class="right">Lượt gọi AI</th><th class="right">Bị chặn</th><th class="right">Lỗi</th>
            <th class="right">Tên gợi ý</th><th class="right">Còn trống</th><th class="right">Thêm vào giỏ</th><th class="right">Chi phí</th>
          </tr></thead>
          <tbody>
            <% ai.thongKe.forEach(function (d) { %>
              <tr>
                <td class="mono"><%= d.day %></td>
                <td class="right"><%= d.calls %></td>
                <td class="right"><%= d.blocked %></td>
                <td class="right"><%= d.errors %></td>
                <td class="right"><%= d.suggested %></td>
                <td class="right"><%= d.available %></td>
                <td class="right"><%= d.added_to_cart %></td>
                <td class="right"><%= formatVnd(Math.round(d.cost_vnd)) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="tiny muted">Chi phí ước tính từ số token OpenAI trả về và đơn giá trong Cấu hình; số tiền thật xem trong tài khoản OpenAI.</p>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>

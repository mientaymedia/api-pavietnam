<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Hồ sơ đổi chủ thể</h1>
  <%- include('../partials/admin-nav') %>

  <div class="alert alert-info">
    Đổi chủ thể <strong>không tự động</strong>: với <code>.vn</code> cần bản khai có chữ ký/con dấu và
    giấy tờ pháp nhân theo quy định VNNIC; với tên miền quốc tế cần xác nhận từ cả hai bên theo ICANN.
    Trang này theo dõi hồ sơ từ lúc khách nộp đến khi hoàn tất. Mỗi lần đổi trạng thái đều gửi email cho khách.
  </div>

  <div class="card">
    <div class="row" style="margin-bottom:14px">
      <% ['', 'pending', 'in_review', 'need_documents', 'approved', 'completed', 'rejected'].forEach(function (s) { %>
        <a class="btn btn-sm <%= status === s ? '' : 'btn-outline' %>" href="<%= base %>/admin/doi-chu-the<%= s ? '?status=' + s : '' %>">
          <%= s === '' ? 'Tất cả' : s %>
        </a>
      <% }); %>
    </div>

    <% if (!requests.length) { %>
      <p class="muted center">Không có hồ sơ nào.</p>
    <% } %>

    <% requests.forEach(function (r) { %>
      <%
        var nhan = {
          pending: ['badge-warn', 'Chờ tiếp nhận'],
          in_review: ['badge-info', 'Đang xem xét'],
          need_documents: ['badge-warn', 'Cần bổ sung giấy tờ'],
          approved: ['badge-info', 'Đã duyệt'],
          completed: ['badge-ok', 'Hoàn tất'],
          rejected: ['badge-danger', 'Từ chối'],
          cancelled: ['badge-muted', 'Đã hủy']
        }[r.status] || ['badge-muted', r.status];
        var cu = ownerSnapshot(r);
      %>
      <div style="padding:16px 0; border-bottom:1px solid var(--line)">
        <div class="row-between">
          <div>
            <strong class="mono"><%= r.domain %></strong>
            <span class="badge <%= nhan[0] %>" style="margin-left:6px"><%= nhan[1] %></span>
            <div class="tiny muted">Hồ sơ #<%= r.id %> &middot; <%= r.email %> &middot; <%= r.created_at.replace('T',' ').slice(0,16) %></div>
          </div>
        </div>

        <div class="grid grid-2" style="margin-top:10px">
          <div>
            <div class="tiny muted">Chủ thể hiện tại</div>
            <div class="small"><%= cu.org_name || cu.full_name || '(không có dữ liệu)' %></div>
            <% if (cu.tax_code) { %><div class="tiny muted">MST: <%= cu.tax_code %></div><% } %>
            <% if (cu.id_number) { %><div class="tiny muted">CCCD: <%= cu.id_number %></div><% } %>
            <% if (cu.email) { %><div class="tiny muted"><%= cu.email %></div><% } %>
          </div>
          <div>
            <div class="tiny muted">Chủ thể mới</div>
            <div class="small"><%= r.new_owner_name || '(hồ sơ đã bị xóa)' %></div>
            <% if (r.new_owner_tax) { %><div class="tiny muted">MST: <%= r.new_owner_tax %></div><% } %>
            <% if (r.new_owner_id) { %><div class="tiny muted">CCCD: <%= r.new_owner_id %></div><% } %>
            <% if (r.new_owner_email) { %><div class="tiny muted"><%= r.new_owner_email %></div><% } %>
          </div>
        </div>

        <% if (r.reason) { %>
          <div class="tiny" style="margin-top:8px"><strong>Lý do:</strong> <%= r.reason %></div>
        <% } %>
        <% if (r.admin_note) { %>
          <div class="tiny muted" style="margin-top:4px"><strong>Ghi chú xử lý:</strong> <%= r.admin_note %></div>
        <% } %>

        <form method="post" action="<%= base %>/admin/doi-chu-the/<%= r.id %>/trang-thai" style="margin-top:10px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row" style="align-items:flex-end">
            <div class="field" style="width:190px; margin:0">
              <label><span class="field-name">Chuyển trạng thái</span>
              <select name="status">
                <% ['in_review','need_documents','approved','completed','rejected','cancelled'].forEach(function (s) { %>
                  <option value="<%= s %>"><%= s %></option>
                <% }); %>
              </select></label>
            </div>
            <div class="field" style="flex:1; min-width:220px; margin:0">
              <label><span class="field-name">Ghi chú gửi cho khách</span>
              <input type="text" name="note" placeholder="VD: vui lòng nộp bản khai có dấu và giấy ĐKKD"></label>
            </div>
            <button class="btn btn-sm" type="submit">Cập nhật</button>
          </div>
        </form>
      </div>
    <% }); %>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <h1>Đối soát ngân hàng (SePay)</h1>
  <%- include('../partials/admin-nav') %>

  <div class="card">
    <p class="muted small">
      Mọi giao dịch SePay báo về đều được ghi lại ở đây, kể cả giao dịch không khớp đơn hàng -
      giúp bạn tra soát khi khách báo "đã chuyển tiền rồi".
    </p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Thời gian</th><th>Mã GD</th><th class="right">Số tiền</th><th>Nội dung</th><th>Mã đơn dò được</th><th>Kết quả</th></tr></thead>
        <tbody>
          <% if (!transactions.length) { %>
            <tr><td colspan="6" class="muted center">Chưa nhận giao dịch nào. Kiểm tra webhook đã trỏ đúng URL chưa.</td></tr>
          <% } %>
          <% transactions.forEach(function (t) { %>
            <tr>
              <td class="small"><%= t.created_at.replace('T', ' ').slice(0, 16) %></td>
              <td class="mono tiny"><%= t.external_id %></td>
              <td class="right"><%= formatVnd(t.amount) %></td>
              <td class="tiny" style="max-width:280px; word-break:break-all"><%= t.content %></td>
              <td class="mono small"><%= t.matched_code || '-' %></td>
              <td>
                <%
                  var m = {
                    matched: ['badge-ok', 'Đã khớp đơn'],
                    duplicate: ['badge-muted', 'Trùng / đã xử lý'],
                    unmatched: ['badge-warn', 'Không khớp'],
                    amount_mismatch: ['badge-danger', 'Sai số tiền'],
                    received: ['badge-muted', 'Đã nhận']
                  }[t.status] || ['badge-muted', t.status];
                %>
                <span class="badge <%= m[0] %>"><%= m[1] %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>

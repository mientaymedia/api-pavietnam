<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container">
  <%- include('../partials/flash') %>
  <div class="row-between">
    <h1>Báo cáo kinh doanh</h1>
    <div class="row">
      <a class="btn btn-sm btn-outline" href="<%= base %>/admin/xuat/doanh-thu">Xuất doanh thu</a>
      <a class="btn btn-sm btn-outline" href="<%= base %>/admin/xuat/don-hang">Xuất đơn hàng</a>
      <a class="btn btn-sm btn-outline" href="<%= base %>/admin/xuat/ten-mien">Xuất tên miền</a>
    </div>
  </div>
  <%- include('../partials/admin-nav') %>

  <div class="alert alert-info tiny">
    Doanh thu chỉ tính các tên miền <strong>đã kích hoạt</strong> thuộc đơn đã thanh toán -
    dòng thất bại hoặc đã hoàn tiền không được tính. Giá vốn lấy từ bảng giá <strong>tại thời điểm xem</strong>,
    nên nếu bạn sửa giá vốn thì số lãi của kỳ cũ sẽ thay đổi theo.
  </div>

  <!-- ---------------------------------------------------------- tong quan -->
  <div class="grid grid-4">
    <div class="stat">
      <div class="stat-value"><%= formatVnd(tongQuan.doanhThu) %></div>
      <div class="stat-label">Doanh thu</div>
    </div>
    <div class="stat">
      <div class="stat-value" style="color:var(--ok)"><%= formatVnd(tongQuan.lai) %></div>
      <div class="stat-label">Lãi gộp &middot; <%= tongQuan.tyLeLai %>%</div>
    </div>
    <div class="stat">
      <div class="stat-value"><%= tongQuan.soTenMien %></div>
      <div class="stat-label">Tên miền đã bán &middot; <%= tongQuan.soKhachHang %> khách</div>
    </div>
    <div class="stat">
      <div class="stat-value"><%= formatVnd(tongQuan.giaTriDonTrungBinh) %></div>
      <div class="stat-label">Giá trị đơn trung bình</div>
    </div>
  </div>

  <!-- ------------------------------------------------- doanh thu theo thang -->
  <div class="card viz" style="margin-top:18px">
    <div class="card-title">
      <h2>Doanh thu 12 tháng gần nhất</h2>
      <a class="small" href="<%= base %>/admin/xuat/doanh-thu">Tải CSV</a>
    </div>

    <% if (!theoThang.length) { %>
      <p class="muted center" style="padding:32px 0">Chưa có doanh thu nào được ghi nhận.</p>
    <% } else { %>
      <div class="viz-legend">
        <span class="viz-key"><span class="viz-swatch" style="background:var(--series-lai)"></span> Lãi gộp</span>
        <span class="viz-key"><span class="viz-swatch" style="background:var(--series-von)"></span> Giá vốn</span>
      </div>

      <div class="viz-bars">
        <% theoThang.forEach(function (t, idx) { %>
          <%
            // Khung cao 250px: tru cho nhan so (18) + nhan thang (20) + le
            var caoNhat = 200;
            var caoCot  = Math.round((t.doanhThu / dinhTruc) * caoNhat);
            var caoLai  = t.doanhThu > 0 ? Math.round(caoCot * (Math.max(0, t.lai) / t.doanhThu)) : 0;
            var caoVon  = Math.max(0, caoCot - caoLai);
            var laThangCuoi = idx === theoThang.length - 1;
            var trieu = (t.doanhThu / 1e6);
          %>
          <div class="viz-col" tabindex="0">
            <div class="viz-tip">
              <b><%= t.thang %></b><br>
              Doanh thu: <b><%= formatVnd(t.doanhThu) %></b><br>
              Giá vốn: <%= formatVnd(t.giaVon) %><br>
              Lãi gộp: <b><%= formatVnd(t.lai) %></b><br>
              <%= t.doanhThu === 0 ? 'Không có doanh thu' : t.soDon + ' đơn &middot; ' + t.soTenMien + ' tên miền' %>
            </div>

            <!-- Chi ghi so tren cot thang cuoi: dat so tren moi cot se roi mat -->
            <% if (laThangCuoi && t.doanhThu > 0) { %>
              <div class="viz-vlabel"><%= trieu >= 1 ? trieu.toFixed(1) + 'tr' : Math.round(t.doanhThu / 1000) + 'k' %></div>
            <% } %>

            <div class="viz-stack" style="height:<%= Math.max(caoCot, 2) %>px">
              <% if (caoLai > 0) { %><div class="viz-seg viz-seg-lai" style="height:<%= caoLai %>px"></div><% } %>
              <% if (caoVon > 0) { %><div class="viz-seg viz-seg-von" style="height:<%= caoVon %>px"></div><% } %>
              <% if (t.doanhThu === 0) { %><div class="viz-seg viz-seg-trong"></div><% } %>
            </div>
            <div class="viz-xlabel"><%= t.thang.slice(5) %>/<%= t.thang.slice(2, 4) %></div>
          </div>
        <% }); %>
      </div>

      <details style="margin-top:16px">
        <summary class="small muted" style="cursor:pointer">Xem dạng bảng số liệu</summary>
        <div class="table-wrap" style="margin-top:10px">
          <table>
            <thead><tr><th>Tháng</th><th class="right">Doanh thu</th><th class="right">Giá vốn</th><th class="right">Lãi gộp</th><th class="right">Tỷ lệ lãi</th><th class="right">Đơn</th></tr></thead>
            <tbody>
              <% theoThang.slice().reverse().forEach(function (t) { %>
                <tr>
                  <td class="mono small"><%= t.thang %></td>
                  <td class="right"><%= formatVnd(t.doanhThu) %></td>
                  <td class="right muted"><%= formatVnd(t.giaVon) %></td>
                  <td class="right" style="color:var(--ok)"><%= formatVnd(t.lai) %></td>
                  <td class="right small"><%= t.doanhThu > 0 ? Math.round(t.lai / t.doanhThu * 100) : 0 %>%</td>
                  <td class="right small"><%= t.soDon %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </details>
    <% } %>
  </div>

  <div class="grid grid-2" style="align-items:start">
    <!-- ------------------------------------------------ doanh thu theo duoi -->
    <div class="card viz">
      <div class="card-title"><h2>Theo đuôi tên miền</h2></div>
      <% if (!theoDuoi.length) { %>
        <p class="muted small">Chưa có dữ liệu.</p>
      <% } else { %>
        <% var dinhDuoi = Math.max(1, ...theoDuoi.map(function (d) { return d.doanhThu; })); %>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Đuôi</th><th class="right">SL</th><th class="right">Doanh thu</th><th class="right">Lãi</th><th style="width:110px"></th></tr></thead>
            <tbody>
              <% theoDuoi.forEach(function (d) { %>
                <tr>
                  <td><strong>.<%= d.tld %></strong></td>
                  <td class="right small"><%= d.soLuong %></td>
                  <td class="right"><%= formatVnd(d.doanhThu) %></td>
                  <td class="right" style="color:<%= d.lai >= 0 ? 'var(--ok)' : 'var(--danger)' %>">
                    <%= formatVnd(d.lai) %>
                    <div class="tiny muted"><%= d.tyLeLai %>%</div>
                  </td>
                  <td>
                    <div class="viz-rowbar-track">
                      <div class="viz-rowbar" style="width:<%= Math.round(d.doanhThu / dinhDuoi * 100) %>%"></div>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- ----------------------------------------------------- du bao gia han -->
    <div class="card">
      <div class="card-title"><h2>Dự kiến doanh thu gia hạn</h2></div>
      <p class="muted small" style="margin-top:-6px">Nếu toàn bộ tên miền sắp hết hạn đều được gia hạn 1 năm.</p>
      <% duBao.forEach(function (m) { %>
        <div class="copy-row">
          <span class="label">Trong <%= m.soNgay %> ngày tới
            <div class="tiny muted"><%= m.soTenMien %> tên miền</div>
          </span>
          <span class="value"><%= formatVnd(m.duKienDoanhThu) %></span>
        </div>
      <% }); %>

      <h3 class="section-heading">Tiền thực nhận theo phương thức</h3>
      <% if (!phuongThuc.length) { %>
        <p class="muted small">Chưa có giao dịch nào.</p>
      <% } else { %>
        <% phuongThuc.forEach(function (p) { %>
          <div class="copy-row">
            <span class="label"><%= p.provider === 'sepay' ? 'Chuyển khoản (SePay)' : p.provider === 'balance' ? 'Số dư tài khoản' : p.provider === 'manual' ? 'Xác nhận thủ công' : p.provider %>
              <div class="tiny muted"><%= p.soGiaoDich %> giao dịch</div>
            </span>
            <span class="value"><%= formatVnd(p.tongTien) %></span>
          </div>
        <% }); %>
      <% } %>

      <% if (tongQuan.daHoanTien) { %>
        <div class="copy-row" style="border-top:1px solid var(--line); margin-top:6px; padding-top:12px">
          <span class="label">Đã hoàn cho khách</span>
          <span class="value" style="color:var(--danger)">-<%= formatVnd(tongQuan.daHoanTien) %></span>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ------------------------------------------------------- khach hang -->
  <div class="card">
    <div class="card-title"><h2>Khách hàng đóng góp nhiều nhất</h2></div>
    <% if (!khachHang.length) { %>
      <p class="muted small">Chưa có dữ liệu.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Khách hàng</th><th class="right">Tên miền</th><th class="right">Doanh thu</th></tr></thead>
          <tbody>
            <% khachHang.forEach(function (k) { %>
              <tr>
                <td><strong><%= k.hoTen || '(chưa đặt tên)' %></strong><div class="tiny muted"><%= k.email %></div></td>
                <td class="right"><%= k.soTenMien %></td>
                <td class="right"><%= formatVnd(k.doanhThu) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>

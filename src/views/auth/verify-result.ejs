<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container container-narrow">
  <div class="card center">
    <% if (outcome === 'ok') { %>
      <div style="font-size:44px; line-height:1">&#10003;</div>
      <h1>Xác thực thành công</h1>
      <p class="muted">Địa chỉ email của bạn đã được xác nhận. Từ bây giờ bạn sẽ nhận được
        thông tin quản trị tên miền, cảnh báo hết hạn và hóa đơn qua email này.</p>
      <a class="btn btn-lg" href="<%= base %><%= loggedIn ? '/dashboard' : '/dang-nhap' %>">
        <%= loggedIn ? 'Vào bảng điều khiển' : 'Đăng nhập' %>
      </a>

    <% } else if (outcome === 'already_verified') { %>
      <h1>Email đã được xác thực</h1>
      <p class="muted">Địa chỉ email này đã được xác thực trước đó. Bạn không cần làm gì thêm.</p>
      <a class="btn" href="<%= base %><%= loggedIn ? '/dashboard' : '/dang-nhap' %>">Tiếp tục</a>

    <% } else if (outcome === 'expired') { %>
      <h1>Liên kết đã hết hạn</h1>
      <p class="muted">Liên kết xác thực chỉ có hiệu lực trong 24 giờ.
        Đăng nhập rồi bấm <strong>Gửi lại email xác thực</strong> để nhận liên kết mới.</p>
      <a class="btn" href="<%= base %>/dang-nhap">Đăng nhập để gửi lại</a>

    <% } else { %>
      <h1>Liên kết không hợp lệ</h1>
      <p class="muted">Liên kết này không đúng, đã được dùng rồi, hoặc bạn đã đổi địa chỉ email
        kể từ lúc nhận thư. Đăng nhập để yêu cầu gửi lại liên kết mới.</p>
      <a class="btn" href="<%= base %>/dang-nhap">Đăng nhập</a>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>

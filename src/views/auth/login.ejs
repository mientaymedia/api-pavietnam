<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container container-narrow">
  <%- include('../partials/flash') %>
  <div class="card">
    <h1>Đăng nhập</h1>
    <% if (errors._) { %><div class="alert alert-error"><%= errors._ %></div><% } %>

    <form method="post" action="<%= base %>/dang-nhap">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="next" value="<%= next %>">

      <div class="field">
        <label for="email"><span class="field-name">Email</span>
        <input id="email" type="email" name="email" value="<%= values.email || '' %>" required autofocus autocomplete="email"></label>
      </div>
      <div class="field">
        <label for="password"><span class="field-name">Mật khẩu</span>
        <input id="password" type="password" name="password" required autocomplete="current-password"></label>
      </div>

      <button class="btn btn-block btn-lg" type="submit">Đăng nhập</button>
    </form>

    <p class="small muted center" style="margin:16px 0 0">
      <a href="<%= base %>/quen-mat-khau">Quên mật khẩu?</a> &middot; Chưa có tài khoản? <a href="<%= base %>/dang-ky">Đăng ký</a>
    </p>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container container-narrow">
  <div class="card">
    <h1>Quen mat khau</h1>
    <% if (sent) { %>
      <div class="alert alert-success">
        Neu email ton tai trong he thong, chung toi da gui huong dan dat lai mat khau.
        Vui long kiem tra hop thu (ke ca thu muc spam).
      </div>
      <a class="btn btn-outline" href="/dang-nhap">Ve trang dang nhap</a>
    <% } else { %>
      <p class="muted small">Nhap email dang ky, chung toi se gui lien ket dat lai mat khau.</p>
      <form method="post" action="/quen-mat-khau">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="email"><span class="field-name">Email</span>
          <input id="email" type="email" name="email" required autofocus></label>
        </div>
        <button class="btn btn-block" type="submit">Gui lien ket</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>

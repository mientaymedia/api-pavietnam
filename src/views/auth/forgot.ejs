<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container container-narrow">
  <div class="card">
    <h1>Quên mật khẩu</h1>
    <% if (sent) { %>
      <div class="alert alert-success">
        Nếu email tồn tại trong hệ thống, chúng tôi đã gửi hướng dẫn đặt lại mật khẩu.
        Vui lòng kiểm tra hộp thư (kể cả thư mục spam).
      </div>
      <a class="btn btn-outline" href="<%= base %>/dang-nhap">Về trang đăng nhập</a>
    <% } else { %>
      <p class="muted small">Nhập email đăng ký, chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p>
      <form method="post" action="<%= base %>/quen-mat-khau">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="email"><span class="field-name">Email</span>
          <input id="email" type="email" name="email" required autofocus></label>
        </div>
        <button class="btn btn-block" type="submit">Gửi liên kết</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>

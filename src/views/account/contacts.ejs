<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container container-mid">
  <%- include('../partials/flash') %>
  <h1>Hồ sơ chủ thể tên miền</h1>
  <p class="muted small">Thông tin này được gửi lên nhà đăng ký khi đăng ký tên miền. Với tên miền .vn, thông tin phải chính xác theo giấy tờ pháp lý.</p>

  <div class="card">
    <div class="card-title"><h2>Hồ sơ đã lưu</h2></div>
    <% if (!contacts.length) { %>
      <p class="muted small">Chưa có hồ sơ nào.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Chủ thể</th><th>Loại</th><th>Liên hệ</th><th></th></tr></thead>
          <tbody>
            <% contacts.forEach(function (c) { %>
              <tr>
                <td>
                  <strong><%= c.full_name %></strong>
                  <% if (c.is_default) { %><span class="badge badge-ok" style="margin-left:6px">Mặc định</span><% } %>
                  <% if (c.org_name) { %><div class="tiny muted"><%= c.org_name %></div><% } %>
                  <% if (c.canBoSung.length) { %>
                    <div class="tiny" style="color:var(--warn)">Cần bổ sung: <%= c.canBoSung.join('; ') %></div>
                  <% } %>
                </td>
                <td>
                  <span class="badge badge-muted"><%= c.kind === 'organization' ? 'Tổ chức' : 'Cá nhân' %></span>
                  <div class="tiny muted"><%= c.kind === 'organization' ? (c.tax_code ? 'MST: ' + c.tax_code : '') : (c.id_number ? 'CCCD: ' + c.id_number : '') %></div>
                </td>
                <td class="small"><%= c.email %><div class="tiny muted"><%= c.phone %></div></td>
                <td class="right nowrap">
                  <a class="tiny" href="<%= base %>/tai-khoan/ho-so?sua=<%= c.id %>#sua-ho-so">Sửa</a>
                  <% if (!c.is_default) { %>
                    <form method="post" action="<%= base %>/tai-khoan/ho-so/<%= c.id %>/mac-dinh" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn-link tiny" type="submit">Đặt mặc định</button>
                    </form>
                  <% } %>
                  <form method="post" action="<%= base %>/tai-khoan/ho-so/<%= c.id %>/xoa" data-confirm="Xóa hồ sơ này?" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn-link tiny" type="submit" style="color:var(--danger)">Xóa</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="card" id="sua-ho-so">
    <div class="card-title"><h2><%= values.id ? 'Sửa hồ sơ' : 'Thêm hồ sơ mới' %></h2></div>
    <form method="post" action="<%= base %>/tai-khoan/ho-so">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (values.id) { %><input type="hidden" name="id" value="<%= values.id %>"><% } %>
      <%- include('../partials/contact-form', { values: values, errors: errors }) %>
      <button class="btn" type="submit">Lưu hồ sơ</button>
      <% if (values.id) { %><a class="btn btn-outline" href="<%= base %>/tai-khoan/ho-so">Hủy sửa</a><% } %>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
  <div class="container center">
    <h1>Đăng ký tên miền Việt Nam &amp; Quốc tế</h1>
    <p><%= site.tagline %></p>

    <form class="search-box" action="<%= base %>/tim-kiem" method="get">
      <input type="search" name="q" aria-label="Tên miền cần tìm" placeholder="Nhập tên miền bạn muốn, ví dụ: congtyabc" required autofocus>
      <button class="btn btn-lg" type="submit">Kiểm tra</button>
    </form>

    <% if (chips.length) { %>
      <div class="tld-chips">
        <% chips.slice(0, 8).forEach(function (t) { %>
          <span class="tld-chip">.<%= t.tld %> &middot; <%= formatVnd(priceFor(t, 'register', 1).total) %></span>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<div class="container" style="margin-top:28px">
  <%- include('partials/flash') %>

  <div class="grid grid-3">
    <div class="card">
      <h3>Kích hoạt tức thì</h3>
      <p class="muted small">Thanh toán xong là tên miền được đăng ký tự động qua API nhà đăng ký, không chờ duyệt thủ công.</p>
    </div>
    <div class="card">
      <h3>Quản lý DNS đầy đủ</h3>
      <p class="muted small">Thêm, sửa, xóa bản ghi A / AAAA / CNAME / MX / TXT / NS / SRV / CAA và đổi nameserver ngay trong Control Panel.</p>
    </div>
    <div class="card">
      <h3>Thanh toán tự động</h3>
      <p class="muted small">Quét QR chuyển khoản ngân hàng, hệ thống đối soát tự động. Hỗ trợ thêm ví MoMo và ZaloPay.</p>
    </div>
  </div>

  <h2 class="section-heading">Bảng giá nổi bật</h2>
  <div class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>Đuôi</th><th>Loại</th><th class="right">Đăng ký năm đầu</th><th class="right">Gia hạn / năm</th><th></th></tr>
        </thead>
        <tbody>
          <% chips.slice(0, 12).forEach(function (t) { %>
            <tr>
              <td><strong>.<%= t.tld %></strong><% if (t.label) { %><div class="tiny muted"><%= t.label %></div><% } %></td>
              <td><span class="badge badge-muted"><%= t.kind === 'vn' ? 'Việt Nam' : 'Quốc tế' %></span></td>
              <td class="right"><strong><%= formatVnd(priceFor(t, 'register', 1).total) %></strong></td>
              <td class="right"><%= formatVnd(priceFor(t, 'renew', 1).total) %></td>
              <td class="right"><a class="btn btn-sm btn-outline" href="<%= base %>/tim-kiem?q=<%= encodeURIComponent('ten-mien-cua-ban.' + t.tld) %>">Kiểm tra</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="tiny muted" style="margin:14px 0 0">Giá đã bao gồm VAT nếu được cấu hình. Xem đầy đủ tại <a href="<%= base %>/bang-gia">bảng giá</a>.</p>
  </div>
</div>

<%- include('partials/footer') %>

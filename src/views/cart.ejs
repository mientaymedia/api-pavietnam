<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="container container-mid">
  <%- include('partials/flash') %>
  <h1>Giỏ hàng</h1>

  <% if (!cart.lines.length) { %>
    <div class="card center">
      <p class="muted">Giỏ hàng đang trống.</p>
      <a class="btn" href="<%= base %>/">Tìm tên miền</a>
    </div>
  <% } else { %>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Tên miền</th><th>Dịch vụ</th><th style="width:120px">Thời hạn</th><th class="right">Thành tiền</th><th></th></tr>
          </thead>
          <tbody>
            <% cart.lines.forEach(function (line) { %>
              <tr>
                <td>
                  <strong class="mono"><%= line.domain %></strong>
                  <% if (line.requiresVnContact) { %><div class="tiny muted">Cần hồ sơ chủ thể (.vn)</div><% } %>
                </td>
                <td><span class="badge badge-muted"><%= line.action === 'register' ? 'Đăng ký mới' : line.action === 'renew' ? 'Gia hạn' : 'Chuyển về' %></span></td>
                <td>
                  <form method="post" action="<%= base %>/gio-hang/cap-nhat/<%= line.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="years" aria-label="Số năm cho <%= line.domain %>" data-submit-on-change>
                      <% for (var y = 1; y <= 10; y++) { %>
                        <option value="<%= y %>" <%= line.years === y ? 'selected' : '' %>><%= y %> năm</option>
                      <% } %>
                    </select>
                  </form>
                </td>
                <td class="right">
                  <strong><%= formatVnd(line.total) %></strong>
                  <% if (line.vat) { %><div class="tiny muted">gồm VAT <%= formatVnd(line.vat) %></div><% } %>
                </td>
                <td class="right">
                  <form method="post" action="<%= base %>/gio-hang/xoa/<%= line.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn-link tiny" type="submit">Xóa</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="row-between" style="margin-top:18px; padding-top:16px; border-top:1px solid var(--line)">
        <form method="post" action="<%= base %>/gio-hang/xoa-het">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-link small" type="submit">Xóa toàn bộ giỏ hàng</button>
        </form>
        <div class="right">
          <div class="muted small">Tạm tính: <%= formatVnd(cart.subtotal) %><% if (cart.vat) { %> + VAT <%= formatVnd(cart.vat) %><% } %></div>
          <div style="font-size:1.3rem; font-weight:700"><%= formatVnd(cart.total) %></div>
        </div>
      </div>
    </div>

    <div class="right" style="margin-top:18px">
      <a class="btn btn-lg" href="<%= base %>/thanh-toan">Tiến hành thanh toán</a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>

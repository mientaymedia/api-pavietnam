<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container container-mid">
  <%- include('../partials/flash') %>
  <h1>Don hang cua toi</h1>

  <div class="card">
    <% if (!orders.length) { %>
      <p class="muted">Ban chua co don hang nao. <a href="/">Tim ten mien</a>.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Ma don</th><th>Ngay tao</th><th>Trang thai</th><th class="right">Tong tien</th><th></th></tr></thead>
          <tbody>
            <% orders.forEach(function (o) { %>
              <tr>
                <td class="mono"><strong><%= o.code %></strong></td>
                <td class="small"><%= o.created_at.replace('T', ' ').slice(0, 16) %></td>
                <td><%- include('../partials/order-status', { status: o.status }) %></td>
                <td class="right"><%= formatVnd(o.total) %></td>
                <td class="right"><a class="btn btn-sm btn-outline" href="/don-hang/<%= o.code %>">Chi tiet</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>
<div class="container container-mid">
  <%- include('../partials/flash') %>
  <h1>Đơn hàng của tôi</h1>

  <div class="card">
    <% if (!orders.length) { %>
      <p class="muted">Bạn chưa có đơn hàng nào. <a href="<%= base %>/">Tìm tên miền</a>.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Mã đơn</th><th>Ngày tạo</th><th>Trạng thái</th><th class="right">Tổng tiền</th><th></th></tr></thead>
          <tbody>
            <% orders.forEach(function (o) { %>
              <tr>
                <td class="mono"><strong><%= o.code %></strong></td>
                <td class="small"><%= o.created_at.replace('T', ' ').slice(0, 16) %></td>
                <td><%- include('../partials/order-status', { status: o.status }) %></td>
                <td class="right"><%= formatVnd(o.total) %></td>
                <td class="right"><a class="btn btn-sm btn-outline" href="<%= base %>/don-hang/<%= o.code %>">Chi tiết</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>

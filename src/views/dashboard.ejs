<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="container">
  <%- include('partials/flash') %>
  <div class="row-between">
    <h1>Xin chào, <%= currentUser.full_name || currentUser.email %></h1>
    <a class="btn" href="<%= base %>/">Đăng ký tên miền mới</a>
  </div>

  <div class="grid grid-4" style="margin:18px 0">
    <div class="stat"><div class="stat-value"><%= stats.domains %></div><div class="stat-label">Tên miền</div></div>
    <div class="stat"><div class="stat-value"><%= stats.active %></div><div class="stat-label">Đang hoạt động</div></div>
    <div class="stat"><div class="stat-value" style="color:var(--warn)"><%= stats.expiringSoon %></div><div class="stat-label">Sắp hết hạn (30 ngày)</div></div>
    <div class="stat"><div class="stat-value"><%= formatVnd(currentUser.balance) %></div><div class="stat-label">Số dư tài khoản</div></div>
  </div>

  <div class="card">
    <div class="card-title"><h2>Tên miền của bạn</h2><a class="small" href="<%= base %>/control-panel">Xem tất cả</a></div>
    <% if (!domains.length) { %>
      <p class="muted">Bạn chưa có tên miền nào. <a href="<%= base %>/">Tìm và đăng ký ngay</a>.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tên miền</th><th>Trạng thái</th><th>Hết hạn</th><th></th></tr></thead>
          <tbody>
            <% domains.slice(0, 8).forEach(function (d) { %>
              <tr>
                <td class="mono"><strong><%= d.domain %></strong></td>
                <td>
                  <span class="badge <%= d.status === 'active' ? 'badge-ok' : d.status === 'expired' ? 'badge-danger' : 'badge-muted' %>"><%= d.status %></span>
                </td>
                <td>
                  <%= d.expires_at ? d.expires_at.slice(0, 10) : '-' %>
                  <% if (d.daysLeft !== null && d.daysLeft <= 30) { %>
                    <div class="tiny" style="color:var(--warn)"><%= d.daysLeft >= 0 ? 'Còn ' + d.daysLeft + ' ngày' : 'Đã hết hạn' %></div>
                  <% } %>
                </td>
                <td class="right"><a class="btn btn-sm btn-outline" href="<%= base %>/control-panel/<%= d.domain %>">Quản lý</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="card">
    <div class="card-title"><h2>Đơn hàng gần đây</h2><a class="small" href="<%= base %>/don-hang">Xem tất cả</a></div>
    <% if (!orders.length) { %>
      <p class="muted">Chưa có đơn hàng nào.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Mã đơn</th><th>Ngày</th><th>Trạng thái</th><th class="right">Tổng tiền</th><th></th></tr></thead>
          <tbody>
            <% orders.forEach(function (o) { %>
              <tr>
                <td class="mono"><strong><%= o.code %></strong></td>
                <td class="small"><%= o.created_at.slice(0, 10) %></td>
                <td><%- include('partials/order-status', { status: o.status }) %></td>
                <td class="right"><%= formatVnd(o.total) %></td>
                <td class="right"><a class="btn btn-sm btn-outline" href="<%= base %>/don-hang/<%= o.code %>">Chi tiết</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

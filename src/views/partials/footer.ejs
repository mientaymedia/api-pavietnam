</main>
<footer class="site-footer">
  <div class="container row-between">
    <div>
      <strong><%= site.name %></strong>
      <% if (site.address) { %><span class="muted"> &middot; <%= site.address %></span><% } %>
      <% if (site.hotline) { %><span class="muted"> &middot; Hotline: <%= site.hotline %></span><% } %>
    </div>
    <div class="muted small">
      <a href="<%= base %>/bang-gia">Bảng giá</a> &middot;
      <a href="<%= base %>/whois">WHOIS</a>
      <% if (currentUser) { %> &middot; <a href="<%= base %>/tai-khoan">Tài khoản</a><% } %>
    </div>
  </div>
</footer>
<script src="<%= base %>/js/app.js" defer></script>
</body>
</html>

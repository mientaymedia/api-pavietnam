<%
  var map = {
    pending_payment: ['badge-warn', 'Chờ thanh toán'],
    paid: ['badge-info', 'Đã thanh toán'],
    processing: ['badge-info', 'Đang xử lý'],
    completed: ['badge-ok', 'Hoàn tất'],
    partially_completed: ['badge-warn', 'Hoàn tất một phần'],
    failed: ['badge-danger', 'Thất bại'],
    cancelled: ['badge-muted', 'Đã hủy'],
    refunded: ['badge-info', 'Đã hoàn tiền']
  };
  var s = map[status] || ['badge-muted', status];
%>
<span class="badge <%= s[0] %>"><%= s[1] %></span>

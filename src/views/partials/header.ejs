<header class="site-header">
  <div class="container">
    <a class="brand" href="<%= base %>/">
      <% if (site.logoUrl) { %>
        <img src="<%= site.logoUrl %>" alt="<%= site.name %>" style="height:30px">
      <% } else { %>
        <span class="brand-mark"><%= site.name.trim().charAt(0).toUpperCase() %></span>
      <% } %>
      <span class="brand-text"><%= site.name %></span>
    </a>

    <%
      // Menu dung chung cho ca man hinh rong lan hep - khai bao mot lan de hai
      // ban khong bi lech nhau khi them muc moi.
      var menu = [
        { url: '/', nhan: 'Tìm tên miền', khop: currentPath === '/' },
        { url: '/bang-gia', nhan: 'Bảng giá', khop: currentPath === '/bang-gia' },
        { url: '/whois', nhan: 'WHOIS', khop: currentPath === '/whois' },
        { url: '/chuyen-ten-mien', nhan: 'Chuyển về', khop: currentPath === '/chuyen-ten-mien' }
      ];
      if (currentUser) {
        menu.push({ url: '/control-panel', nhan: 'Control Panel', khop: currentPath.indexOf('/control-panel') === 0 });
        menu.push({ url: '/don-hang', nhan: 'Đơn hàng', khop: currentPath.indexOf('/don-hang') === 0 });
        if (currentUser.role === 'admin' || currentUser.role === 'staff') {
          menu.push({ url: '/admin', nhan: 'Quản trị', khop: currentPath.indexOf('/admin') === 0 });
        }
      }
    %>

    <!-- Nut mo menu: chi hien tren man hinh hep. Dung <details> nen khong can
         JavaScript - menu van mo duoc ke ca khi script loi. -->
    <details class="nav-toggle">
      <summary aria-label="Mở menu"><span class="nav-icon"></span></summary>
      <nav class="nav nav-mobile">
        <% menu.forEach(function (m) { %>
          <a href="<%= base %><%= m.url %>" class="<%= m.khop ? 'active' : '' %>"><%= m.nhan %></a>
        <% }); %>
        <a href="<%= base %>/gio-hang">Giỏ hàng<% if (cartCount) { %><span class="cart-badge"><%= cartCount %></span><% } %></a>
        <% if (currentUser) { %>
          <a href="<%= base %>/tai-khoan"><%= currentUser.full_name || currentUser.email %></a>
          <form method="post" action="<%= base %>/dang-xuat">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit">Thoát</button>
          </form>
        <% } else { %>
          <a href="<%= base %>/dang-nhap">Đăng nhập</a>
          <a href="<%= base %>/dang-ky">Đăng ký</a>
        <% } %>
      </nav>
    </details>

    <nav class="nav nav-desktop">
      <% menu.forEach(function (m) { %>
        <a href="<%= base %><%= m.url %>" class="<%= m.khop ? 'active' : '' %>"><%= m.nhan %></a>
      <% }); %>
      <a href="<%= base %>/gio-hang">Giỏ hàng<% if (cartCount) { %><span class="cart-badge"><%= cartCount %></span><% } %></a>
      <% if (currentUser) { %>
        <a href="<%= base %>/tai-khoan"><%= currentUser.full_name || currentUser.email %></a>
        <form method="post" action="<%= base %>/dang-xuat" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Thoát</button>
        </form>
      <% } else { %>
        <a href="<%= base %>/dang-nhap">Đăng nhập</a>
        <a href="<%= base %>/dang-ky" class="btn btn-sm">Đăng ký</a>
      <% } %>
    </nav>
  </div>
</header>
<% if (typeof needsEmailVerify !== 'undefined' && needsEmailVerify) { %>
  <div style="background:var(--warn-bg); border-bottom:1px solid #fde68a; color:#92400e;">
    <div class="container" style="padding-top:10px; padding-bottom:10px;">
      <div class="row-between" style="gap:10px">
        <span class="small">
          Địa chỉ email <strong><%= currentUser.email %></strong> chưa được xác thực.
          Hệ thống dùng email này để gửi thông tin quản trị tên miền.
        </span>
        <form method="post" action="<%= base %>/gui-lai-xac-thuc" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm" type="submit">Gửi lại email xác thực</button>
        </form>
      </div>
    </div>
  </div>
<% } %>

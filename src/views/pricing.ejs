<%- include('partials/head') %>
<%- include('partials/header') %>

<div class="container">
  <%- include('partials/flash') %>
  <h1>Bảng giá tên miền</h1>
  <p class="muted">Giá hiển thị là giá bán lẻ đã áp dụng chính sách giá của hệ thống.</p>

  <% function priceTable(rows) { %>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Đuôi</th><th class="right">Đăng ký (năm đầu)</th><th class="right">Gia hạn</th>
              <th class="right">Chuyển về</th><th class="right">Thời hạn</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function (t) { %>
              <tr>
                <td>
                  <strong>.<%= t.tld %></strong>
                  <% if (t.requires_vn_contact) { %><span class="badge badge-info" style="margin-left:6px">Cần hồ sơ chủ thể</span><% } %>
                  <% if (t.label) { %><div class="tiny muted"><%= t.label %></div><% } %>
                </td>
                <td class="right"><strong><%= formatVnd(priceFor(t, 'register', 1).total) %></strong>
                  <% if (t.setup_fee) { %><div class="tiny muted">gồm phí khởi tạo</div><% } %>
                </td>
                <td class="right"><%= formatVnd(priceFor(t, 'renew', 1).total) %></td>
                <td class="right"><%= t.price_transfer ? formatVnd(priceFor(t, 'transfer', 1).total) : '-' %></td>
                <td class="right nowrap"><%= t.min_years %>-<%= t.max_years %> năm</td>
                <td class="right"><a class="btn btn-sm btn-outline" href="<%= base %>/tim-kiem?q=<%= encodeURIComponent('ten-mien.' + t.tld) %>">Kiểm tra</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <% if (vn.length) { %>
    <h2 class="section-heading">Tên miền Việt Nam</h2>
    <% priceTable(vn); %>
    <p class="tiny muted">Tên miền .vn bắt buộc khai báo hồ sơ chủ thể theo quy định của VNNIC (CMND/CCCD với cá nhân, mã số thuế với tổ chức).</p>
  <% } %>

  <% if (intl.length) { %>
    <h2 class="section-heading">Tên miền quốc tế</h2>
    <% priceTable(intl); %>
  <% } %>
</div>

<%- include('partials/footer') %>

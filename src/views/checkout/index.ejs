<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container">
  <%- include('../partials/flash') %>
  <h1>Thanh toán</h1>

  <form method="post" action="<%= base %>/thanh-toan">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="coupon" value="<%= coupon %>">

    <div class="sidebar-layout">
      <div>
        <div class="card">
          <div class="card-title"><h2>Hồ sơ chủ thể tên miền</h2></div>

          <% if (cart.requiresVnContact) { %>
            <div class="alert alert-info">
              Giỏ hàng có tên miền <strong>.vn</strong>. Theo quy định của VNNIC, bạn phải khai báo đầy đủ thông tin
              chủ thể (CMND/CCCD với cá nhân, mã số thuế với tổ chức). Thông tin sai có thể khiến tên miền bị thu hồi.
            </div>
          <% } %>

          <% if (contacts.length) { %>
            <div class="field">
              <label>Chọn hồ sơ có sẵn</label>
              <% contacts.forEach(function (c) { %>
                <label class="check" style="padding:9px 0; border-bottom:1px solid var(--line)">
                  <input type="radio" name="contact_id" value="<%= c.id %>" <%= c.is_default ? 'checked' : '' %>>
                  <span>
                    <strong><%= c.full_name %></strong>
                    <span class="badge badge-muted"><%= c.kind === 'organization' ? 'Tổ chức' : 'Cá nhân' %></span>
                    <div class="tiny muted"><%= c.email %> &middot; <%= c.phone %></div>
                  </span>
                </label>
              <% }); %>
              <label class="check" style="padding:9px 0">
                <input type="radio" name="contact_id" value="">
                <span><strong>Tạo hồ sơ mới</strong></span>
              </label>
            </div>
            <details <%= Object.keys(contactErrors).length ? 'open' : '' %>>
              <summary class="small muted" style="cursor:pointer; margin-bottom:12px">Nhập thông tin hồ sơ mới</summary>
              <input type="hidden" name="contact_mode" value="">
              <%- include('../partials/contact-form', { values: values, errors: contactErrors }) %>
            </details>
          <% } else { %>
            <input type="hidden" name="contact_mode" value="new">
            <%- include('../partials/contact-form', { values: values, errors: contactErrors }) %>
          <% } %>
        </div>

        <div class="card">
          <div class="card-title"><h2>Ghi chú đơn hàng</h2></div>
          <textarea name="note" aria-label="Ghi chú đơn hàng" placeholder="Yêu cầu thêm (không bắt buộc)"><%= values.note || '' %></textarea>
        </div>
      </div>

      <aside>
        <div class="card">
          <div class="card-title"><h2>Đơn hàng</h2></div>
          <% cart.lines.forEach(function (line) { %>
            <div class="copy-row">
              <span class="label">
                <span class="mono"><%= line.domain %></span>
                <div class="tiny muted"><%= line.action === 'renew' ? 'Gia hạn' : 'Đăng ký' %> &middot; <%= line.years %> năm</div>
              </span>
              <span class="value"><%= formatVnd(line.total) %></span>
            </div>
          <% }); %>

          <div class="copy-row"><span class="label">Tạm tính</span><span class="value"><%= formatVnd(cart.subtotal) %></span></div>
          <% if (discount) { %>
            <div class="copy-row"><span class="label">Giảm giá (<%= coupon %>)</span><span class="value" style="color:var(--ok)">-<%= formatVnd(discount) %></span></div>
          <% } %>
          <% if (cart.vat) { %>
            <div class="copy-row"><span class="label">VAT</span><span class="value"><%= formatVnd(cart.vat) %></span></div>
          <% } %>
          <div class="copy-row" style="border-top:2px solid var(--line); margin-top:6px; padding-top:12px">
            <span class="label"><strong>Tổng cộng</strong></span>
            <span class="value" style="font-size:1.2rem"><%= formatVnd(Math.max(0, cart.subtotal - discount + cart.vat)) %></span>
          </div>

          <button class="btn btn-block btn-lg" type="submit" style="margin-top:16px">Đặt hàng</button>
          <p class="tiny muted center" style="margin:10px 0 0">Bước tiếp theo bạn sẽ chọn phương thức thanh toán.</p>
        </div>
      </aside>
    </div>
  </form>

  <form class="card" method="post" action="<%= base %>/thanh-toan/ma-giam-gia" style="max-width:420px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Mã giảm giá</label>
    <div class="row">
      <div style="flex:1"><input type="text" name="coupon" value="<%= coupon %>" aria-label="Mã giảm giá" placeholder="Nhập mã"></div>
      <button class="btn btn-outline" type="submit">Áp dụng</button>
    </div>
    <% if (couponError) { %><div class="error-text"><%= couponError %></div><% } %>
    <% if (discount) { %><div class="small" style="color:var(--ok); margin-top:6px">Đã áp dụng, giảm <%= formatVnd(discount) %></div><% } %>
  </form>
</div>

<%- include('../partials/footer') %>
